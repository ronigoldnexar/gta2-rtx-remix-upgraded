FROM ubuntu:25.04
RUN dpkg --add-architecture i386 && apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      wine wine64 wine32:i386 xvfb x11-utils x11-xserver-utils xdotool ffmpeg \
      mesa-vulkan-drivers mesa-vulkan-drivers:i386 libvulkan1 libvulkan1:i386 vulkan-tools \
      libgl1-mesa-dri libgl1-mesa-dri:i386 libgl1 libgl1:i386 libegl1 \
      ca-certificates curl unzip python3 procps winbind fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*
ENV WINEDEBUG=-all
